# Service
# HTTP/WS listen port
PORT=4006

# Pluggable ports (FR-019/020/021/022). Defaults give a single-binary,
# zero-dependency standalone service; the Alkemio deployment overrides them.

# Cross-pod fan-out (hub.Hub): inmemory (single-pod) | redis (multi-pod)

#
# REJECTED AT STARTUP: HUB_MODE=redis together with CHECKPOINT_STORE=file-service.
# There is no document ownership mechanism. Every pod serving a document holds its
# own authoritative copy and flushes the WHOLE document on its own schedule, and
# nothing decides which flush wins — so two pods that briefly diverge (a dropped
# pub/sub message, a partition, a restart) each write a complete state over the
# other, and the later writer silently discards edits it never received. The
# configuration does not prevent that write, so the service refuses to boot rather
# than warning; there is no override.
#
# Supported: a single pod (HUB_MODE=inmemory) with CHECKPOINT_STORE=file-service.
#
# REQUIRED. HUB_MODE and CHECKPOINT_STORE have NO defaults: an omitted or renamed
# key would otherwise boot on the non-durable in-process store while the
# configuration claims a durable one. Startup fails naming the key.
HUB_MODE=inmemory

# Metadata/index store (MetadataStore): inmemory (zero-dep default) |
# rabbitmq (Alkemio server bus)
METADATA_STORE=inmemory

# Snapshot checkpoint store (persistence.CheckpointStore).
#
#   inline       — in-process, NOT durable across a restart. The test suite, the
#                  local development loop, and the zero-dependency smoke test.
#                  Never a deployment option.
#   file-service — the durable store: one stable file per document, rewritten in
#                  place on every flush.
CHECKPOINT_STORE=inline

# Handshake AuthN (AUTH_MODE): how the connecting actor is resolved at the WS
# handshake. Selected INDEPENDENTLY of AuthZ (Wave 5):
#   open   — standalone, everyone anonymous (zero-dep default)
#   header — gateway-terminated: trust the actor id stamped in AUTH_TOKEN_HEADER
#            (the Alkemio prod default; the gateway forwardAuth already validated it).
#            REQUIRES a dedicated gateway-owned AUTH_TOKEN_HEADER (e.g. X-Alkemio-Actor-Id);
#            the client-controllable "Authorization" default is REJECTED in this mode.
#   oidc   — direct validation: BFF cookie session (Redis) + Hydra RS256 bearer (JWKS),
#            mirroring the server's forward-auth controller (off-gateway / defense-in-depth)
AUTH_MODE=open

# Per-document AuthZ (AUTHZ_MODE): authzeval | open. When unset it is DERIVED from
# AUTH_MODE (open→open; header/oidc→authzeval). Set explicitly to combine, e.g.,
# oidc AuthN with open AuthZ.
# AUTHZ_MODE=authzeval

# The request header the `header` AuthN adapter reads the gateway-stamped actor id
# from (default Authorization for standalone; the Alkemio gateway forwards it here):
# AUTH_TOKEN_HEADER=X-Alkemio-Actor-Id

# --- Durable adapters (Wave 2, selected per the modes above) ---

# Redis fan-out (HUB_MODE=redis):
# REDIS_URL=redis://localhost:6379

# RabbitMQ metadata store (METADATA_STORE=rabbitmq) — the unified
# collaboration-save/-fetch/-delete/-info/-contribution contract
# (see specs/001-collaboration-server/contracts/unified-metadata-rmq.md):
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=alkemio-admin
# RABBITMQ_PASSWORD=alkemio!
# RABBITMQ_QUEUE=alkemio-collaboration
# (or set RABBITMQ_URL=amqp://user:pass@host:5672/ directly)
# The document lifecycle consumer (document.deleted) binds
# its OWN queue, separate from the metadata-store RPC queue above — sharing one queue
# would let RabbitMQ round-robin-steal fetch/save RPCs. Defaults to
# alkemio-collaboration-lifecycle; must differ from RABBITMQ_QUEUE.
# LIFECYCLE_QUEUE=alkemio-collaboration-lifecycle


# file-service blob store (CHECKPOINT_STORE=file-service) — offload via the existing
# /internal/file API (OPEN-2; no file-service expansion):
# FILE_SERVICE_URL=http://file-service:4003
# FILE_SERVICE_STORAGE_BUCKET_ID=<uuid>
# FILE_SERVICE_AUTHORIZATION_ID=<uuid>
# MAX_UPLOAD_SIZE=33554432

# authzeval (AUTHZ_MODE=authzeval, incl. the
# header/oidc derivations) — h2c HTTP/2 to the authorization-evaluation-service:
# AUTH_SERVICE_URL=http://authorization-evaluation-service:6060
# AUTH_BREAKER_FAILURE_THRESHOLD=3
# AUTH_BREAKER_TIMEOUT_SECONDS=15
# AUTH_BREAKER_HALF_OPEN_MAX_REQUESTS=2

# oidc direct-validation (AUTH_MODE=oidc) — env names mirror the server's OIDC
# config. At least ONE of the two paths must be configured; each is INERT when its
# config is absent (no JWKS URL → bearer path off; no session Redis → cookie off).
#  Cookie session path (BFF Redis-backed session → alkemio_actor_id):
# SESSION_REDIS_URL=redis://localhost:6379   # defaults to REDIS_URL when unset
# OIDC_SESSION_COOKIE_NAME=alkemio_session   # env-suffixed per environment
#  Hydra RS256 bearer path (JWKS-validated access token → alkemio_actor_id claim):
# HYDRA_JWKS_URL=http://hydra:4444/.well-known/jwks.json
# HYDRA_ISSUER_URL=http://hydra:4444/
# BEARER_AUD_ALLOW_LIST=alkemio-web,synapse-client,element-client,ecosystem-analytics
# OIDC_CLOCK_SKEW_SECONDS=30

# --- Durability cadence and limits ---

# The flush interval: time from the first unsaved edit until the document's
# state is written (default 2000ms, matching the legacy whiteboard cadence).
# Further edits in that window are coalesced; they do not reset the timer. 0
# disables the periodic flush entirely, so a document is written only on
# idle-release/close; the shutdown flush is unconditional either way.
#
# WRITE-VOLUME ENVELOPE. Each flush writes the WHOLE document, so the steady-state
# write rate is:
#
#     document size ÷ flush interval × continuously-edited documents
#
# At the 30 MiB MAX_DOC_BYTES ceiling and the 2000ms default, one document being
# edited without pause costs 15 MiB/s of writes — the worst case, not the
# expectation. The trailing throttle rearms only after the previous save and a
# subsequent edit.
# Sizing is against that ceiling rather than the average because it is the number
# that saturates file-service. Raise the interval to cut write volume at the cost
# of a longer window of unsaved edits; lower it for the reverse.
# SAVE_DEBOUNCE_MILLIS=2000

# How many CONSECUTIVE failed flushes a document tolerates before durability
# escalation tears the room down and DISCARDS the unsaved edits (default 5).
#
# This is a tolerance for transient backend faults, not a retry budget to be
# maximised: every extra attempt is another window in which edits accumulate with
# nowhere durable to go. Failed flushes retry on exponential backoff from
# SAVE_DEBOUNCE_MILLIS, capped at 30s.
# FLUSH_FAILURE_THRESHOLD=5

# Largest encoded document accepted, in bytes (default 31457280 = 30 MiB).
# Deliberately BELOW file-service's 32 MiB rewrite-body cap: a document sized at
# exactly 32 MiB encodes past it once v2 framing is added, so it would clear this
# check and then be refused by the transport — accepted, and permanently
# unsaveable.
# MAX_DOC_BYTES=31457280

# MAX_CONNS_PER_ROOM=50
# UPDATE_RATE_PER_SEC=0               # off by default; a non-zero value counts all inbound frames
# UPDATE_BURST=0                      # defaults to UPDATE_RATE_PER_SEC
# COLLABORATOR_INACTIVITY_SECONDS=0   # off; current activity tracking ignores cursor movement
# CONTRIBUTION_WINDOW_SECONDS=600     # legacy cadence; 0 disables contribution metrics
# IDLE_RELEASE_SECONDS=30             # 0 releases an empty room immediately
