# Service
# HTTP/WS listen port
PORT=4006

# Pluggable ports (FR-019/020/021/022). Defaults give a single-binary,
# zero-dependency standalone service; the Alkemio deployment overrides them.

# Cluster fan-out (ClusterBroadcaster): inmemory (single-pod) | redis (multi-pod)
FANOUT_MODE=inmemory

# Metadata/index store (MetadataStore): rabbitmq (Alkemio server bus) | postgres (standalone)
METADATA_STORE=rabbitmq

# Snapshot blob store (BlobStore): inline | file-service | s3 | local
BLOB_STORE=inline

# Auth (Auth + AuthZ): open (standalone, no auth) | authzeval (Alkemio token + auth-evaluation-service)
AUTH_MODE=open

# --- Wired as their adapters land (T004-T006) ---
# Redis fan-out (FANOUT_MODE=redis):
# REDIS_URL=redis://localhost:6379
#
# Postgres metadata store (METADATA_STORE=postgres):
# ALKEMIO_DATABASE_HOST=localhost
# ALKEMIO_DATABASE_PORT=5432
# ALKEMIO_DATABASE_USERNAME=alkemio_collab_svc
# ALKEMIO_DATABASE_PASSWORD=secret
# ALKEMIO_DATABASE_NAME=alkemio
#
# authzeval (AUTH_MODE=authzeval) — h2c preferred, NATS fallback:
# AUTH_SERVICE_URL=http://localhost:6060
# NATS_URL=nats://localhost:4222
# AUTH_BREAKER_FAILURE_THRESHOLD=3
# AUTH_BREAKER_TIMEOUT_SECONDS=15
# AUTH_BREAKER_HALF_OPEN_MAX_REQUESTS=2
