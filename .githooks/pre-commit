#!/bin/sh
# Pre-commit hook: regenerate the OpenAPI spec when handlers change and check
# for drift. Install: git config core.hooksPath .githooks (or `make setup-hooks`).
#
# The openapi gate is LIVE: collab_api.go carries @Summary/@Router annotations,
# openapi.yaml is generated from them, and apispec.yaml is tuned for that handler.
# (This comment previously said no annotated handlers existed and the block was a
# no-op — both halves became false when the standalone create API landed.)
#
# NOTE ON SCOPE: this hook does NOT run `golangci-lint run`, which the repo's
# CLAUDE.md calls mandatory before committing. That gate is enforced in CI
# (ci-test.yml), not here.

set -e

echo "Pre-commit: checking generated files..."

STAGED=$(git diff --cached --name-only)

NEED_OPENAPI=false
echo "$STAGED" | grep -q "internal/adapter/inbound/http/" && NEED_OPENAPI=true || true

if [ "$NEED_OPENAPI" = true ] && [ -f openapi.yaml ]; then
  echo "  Regenerating openapi.yaml..."
  if command -v apispec >/dev/null 2>&1; then
    make openapi
    git diff --exit-code openapi.yaml || {
      echo "ERROR: openapi.yaml is stale. Run 'make openapi' and stage the changes."
      exit 1
    }
  else
    echo "  WARN: apispec not installed, skipping openapi check"
  fi
fi

echo "Pre-commit: OK"
